generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  namaLengkap  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Peserta {
  id              String   @id @default(cuid())
  nomorPeserta    String   @unique
  namaLengkap     String
  tempatLahir     String?
  tanggalLahir    DateTime?
  alamat          String?
  whatsapp        String?
  foto            String?
  statusAktif     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sesiUjian       SesiUjian[]
  hasil           Hasil[]
}

model KategoriSoal {
  id        String   @id @default(cuid())
  nama      String   @unique
  deskripsi String?
  createdAt DateTime @default(now())
  soal      Soal[]
}

model Soal {
  id            String   @id @default(cuid())
  kategoriId    String
  pertanyaan    String
  pilihanA      String
  pilihanB      String
  pilihanC      String
  pilihanD      String
  pilihanE      String
  kunciJawaban  String
  bobot         Int      @default(1)
  gambar        String?
  pembahasan    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  kategori      KategoriSoal @relation(fields: [kategoriId], references: [id])
  soalUjian     SoalUjian[]
}

model Ujian {
  id              String   @id @default(cuid())
  nama            String
  deskripsi       String?
  tanggalMulai    DateTime
  tanggalSelesai  DateTime
  durasiMenit     Int
  acakSoal        Boolean  @default(false)
  acakJawaban     Boolean  @default(false)
  passingGrade    Int      @default(70)
  tampilkanNilai  Boolean  @default(true)
  tampilkanPembahasan Boolean @default(false)
  status          String   @default("draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  soalUjian       SoalUjian[]
  sesiUjian       SesiUjian[]
  hasil           Hasil[]
}

model SoalUjian {
  id        String @id @default(cuid())
  ujianId   String
  soalId    String
  urutan    Int
  bobot     Int    @default(1)
  ujian     Ujian  @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  soal      Soal   @relation(fields: [soalId], references: [id], onDelete: Cascade)
  jawaban   Jawaban[]
  @@unique([ujianId, soalId])
}

model SesiUjian {
  id              String   @id @default(cuid())
  pesertaId       String
  ujianId         String
  token           String   @unique
  waktuMulai      DateTime @default(now())
  waktuSelesai    DateTime?
  durasiDetik     Int
  status          String   @default("aktif")
  jawabanTersimpan String @default("{}")
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  peserta         Peserta  @relation(fields: [pesertaId], references: [id])
  ujian           Ujian    @relation(fields: [ujianId], references: [id])
  jawaban         Jawaban[]
  hasil           Hasil?
  @@unique([pesertaId, ujianId, status])
}

model Jawaban {
  id          String   @id @default(cuid())
  sesiId      String
  soalUjianId String
  jawaban     String?
  benar       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sesi        SesiUjian  @relation(fields: [sesiId], references: [id])
  soalUjian   SoalUjian  @relation(fields: [soalUjianId], references: [id])
  @@unique([sesiId, soalUjianId])
}

model Hasil {
  id              String   @id @default(cuid())
  sesiId          String   @unique
  pesertaId       String
  ujianId         String
  totalSoal       Int
  jawabanBenar    Int
  jawabanSalah    Int
  tidakDijawab    Int
  totalBobot      Int
  bobotDidapat    Int
  nilai           Float
  statusTarget    String
  peringkat       Int?
  selesaiPada     DateTime @default(now())
  createdAt       DateTime @default(now())
  peserta         Peserta  @relation(fields: [pesertaId], references: [id])
  ujian           Ujian    @relation(fields: [ujianId], references: [id])
  sesiUjian       SesiUjian @relation(fields: [sesiId], references: [id])
}

model Pengumuman {
  id        String   @id @default(cuid())
  judul     String
  isi       String
  prioritas String   @default("normal")
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LogAktivitas {
  id        String   @id @default(cuid())
  userId    String?
  userType  String?
  aksi      String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}

model Pengaturan {
  key   String @id
  value String
}